# ─── LLM ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Agent behaviour ───────────────────────────────────
# Set to "true" to emit full debug traces to LOG_DIR
DEBUG_LOGGING=false
LOG_DIR=logs

# ─── Paths (defaults work without changing anything) ───
VECTOR_STORE_PATH=vector_store/chroma_db
KNOWLEDGE_BASE_PATH=knowledge-base
ORDERS_PATH=data/orders.json

# ─── Model choices ─────────────────────────────────────
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
